{
  "manifest_version": 3,
  "name": "Chromegle-6.0",
  "version": "6.0.0",
  "minimum_chrome_version": "121",
  "description": "Local ICE connection information, IP notes and skip filters for Umingle.",
  "browser_specific_settings": {"gecko": {"id": "chromegle@eolnmsuk", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}},
  "permissions": ["storage", "unlimitedStorage", "sidePanel"],
  "host_permissions": ["https://m52o1m3c29.execute-api.eu-central-1.amazonaws.com/*", "https://umingle.com/*", "https://www.umingle.com/*"],
  "background": {"service_worker": "background.js", "scripts": ["core.js", "background.js"]},
  "action": {"default_title": "Open Chromegle"},
  "side_panel": {"default_path": "sidepanel.html"},
  "sidebar_action": {"default_panel": "sidepanel.html", "default_title": "Chromegle", "open_at_install": false},
  "options_ui": {"page": "settings.html", "open_in_tab": true},
  "content_scripts": [
    {"matches": ["https://umingle.com/*", "https://www.umingle.com/*"], "js": ["bridge.js"], "run_at": "document_start", "world": "MAIN"},
    {"matches": ["https://umingle.com/*", "https://www.umingle.com/*"], "js": ["core.js", "content.js", "sidebar.js"], "run_at": "document_start"}
  ],
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}
}
